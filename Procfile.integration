setup! : mkdir -p dist/sockets
reference after=setup ready=http+unix:dist/sockets/reference.sock:/readyz=204 timeout=30s: spectre-sample --listen="unix:$(pwd)/dist/sockets/reference.sock" --log-json
candidate after=setup ready=http+unix:dist/sockets/candidate.sock:/readyz=204 timeout=30s: spectre-sample --listen="unix:$(pwd)/dist/sockets/candidate.sock" --data="${SPECTRE_CANDIDATE_DATA:-internal/sample/testdata/users.json}" --weather="${SPECTRE_CANDIDATE_WEATHER:-internal/sample/testdata/weather.json}" --revision=candidate --log-json
ingress after=reference,candidate ready=http+unix:dist/sockets/ingress.sock:/readyz=204 timeout=30s: spectre-ingress --listen="unix:$(pwd)/dist/sockets/ingress.sock" --reference="h2c+unix:$(pwd)/dist/sockets/reference.sock" --candidate="h2c+unix:$(pwd)/dist/sockets/candidate.sock" --scripts-dir="${SPECTRE_SCRIPTS_DIR:-internal/sample/scripts}" --descriptors-dir=dist/descriptors --log-level=debug --log-json
verify! after=ingress: if [ -n "${SPECTRE_PROCTOR_LOG:-}" ]; then response-comparison.integration.test.sh verify; fi
