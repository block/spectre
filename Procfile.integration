setup! : mkdir -p dist/sockets
forecasts after=setup ready=http+unix:dist/sockets/forecasts.sock:/readyz=204 timeout=30s: spectre-sample-forecasts --listen="unix:$(pwd)/dist/sockets/forecasts.sock" --log-json
egress after=forecasts ready=http+unix:dist/sockets/egress-health.sock:/readyz=204 timeout=30s: spectre-egress --reference-listen="unix:$(pwd)/dist/sockets/egress-reference.sock" --candidate-listen="unix:$(pwd)/dist/sockets/egress-candidate.sock" --health-listen="unix:$(pwd)/dist/sockets/egress-health.sock" --destination="forecasts.example=http+unix:$(pwd)/dist/sockets/forecasts.sock" --scripts-dir="${SPECTRE_SCRIPTS_DIR:-internal/sample/scripts}" --schema-dir=internal/sample/schema --match-window=1s --log-level=debug --log-json
reference after=egress ready=http+unix:dist/sockets/reference.sock:/readyz=204 timeout=30s: spectre-sample --listen="unix:$(pwd)/dist/sockets/reference.sock" --forecasts="http+unix:$(pwd)/dist/sockets/egress-reference.sock" --log-json
candidate after=egress ready=http+unix:dist/sockets/candidate.sock:/readyz=204 timeout=30s: spectre-sample --listen="unix:$(pwd)/dist/sockets/candidate.sock" --forecasts="http+unix:$(pwd)/dist/sockets/egress-candidate.sock" --data="${SPECTRE_CANDIDATE_DATA:-internal/sample/testdata/users.json}" --weather="${SPECTRE_CANDIDATE_WEATHER:-internal/sample/testdata/weather.json}" --revision=candidate --log-json
ingress after=reference,candidate ready=http+unix:dist/sockets/ingress.sock:/readyz=204 timeout=30s: spectre-ingress --listen="unix:$(pwd)/dist/sockets/ingress.sock" --reference="h2c+unix:$(pwd)/dist/sockets/reference.sock" --candidate="h2c+unix:$(pwd)/dist/sockets/candidate.sock" --scripts-dir="${SPECTRE_SCRIPTS_DIR:-internal/sample/scripts}" --schema-dir=internal/sample/schema --descriptors-dir=dist/descriptors --log-level=debug --log-json
verify! after=ingress: if [ -n "${SPECTRE_PROCTOR_LOG:-}" ]; then response-comparison.integration.test.sh verify; fi
