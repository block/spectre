setup! : mkdir -p dist/sockets
forecasts after=setup ready=http+unix:dist/sockets/forecasts.sock:/readyz=204 timeout=30s: spectre-sample-forecasts --listen="unix:$(pwd)/dist/sockets/forecasts.sock" --log-level=debug --log-json=DEFAULT
supervisor after=forecasts ready=http+unix:dist/sockets/ingress.sock:/readyz=204 timeout=30s: spectre run --no-limits --listen="unix:$(pwd)/dist/sockets/ingress.sock" --socket-dir="$(pwd)/dist/sockets" --reference='spectre-sample --listen=$SPECTRE_LISTEN --forecasts=$SPECTRE_EGRESS --log-level=debug --log-json=DEFAULT' --candidate='spectre-sample --listen=$SPECTRE_LISTEN --forecasts=$SPECTRE_EGRESS --data=${SPECTRE_CANDIDATE_DATA:-internal/sample/testdata/users.json} --weather=${SPECTRE_CANDIDATE_WEATHER:-internal/sample/testdata/weather.json} --revision=candidate --log-level=debug --log-json=DEFAULT' --destination="forecasts.example=http+unix:$(pwd)/dist/sockets/forecasts.sock" --scripts-dir="${SPECTRE_SCRIPTS_DIR:-internal/sample/scripts}" --schema-dir=internal/sample/schema --descriptors-dir=dist/descriptors --match-window=1s --log-level=debug --log-json=DEFAULT
verify! after=supervisor: if [ -n "${SPECTRE_PROCTOR_LOG:-}" ]; then response-comparison.integration.test.sh verify; fi
