setup! : mkdir -p dist/sockets
forecasts after=setup ready=http+unix:dist/sockets/forecasts.sock:/readyz=204 timeout=90s: spectre-sample-forecasts --listen="unix:$(pwd)/dist/sockets/forecasts.sock" --log-level=debug --log-json=DEFAULT
server after=setup ready=http+unix:dist/sockets/server.sock:/readyz=204 timeout=90s: spectre serve --listen="unix:$(pwd)/dist/sockets/server.sock" --log-level=debug --log-json=DEFAULT
reference after=setup: spectre-sample --listen="unix:$(pwd)/dist/sockets/reference.sock" --forecasts="http+unix:$(pwd)/dist/sockets/egress-reference.sock" --log-level=debug --log-json=DEFAULT
candidate after=setup: spectre-sample --listen="unix:$(pwd)/dist/sockets/candidate.sock" --forecasts="http+unix:$(pwd)/dist/sockets/egress-candidate.sock" --data="${SPECTRE_CANDIDATE_DATA:-internal/sample/testdata/users.json}" --weather="${SPECTRE_CANDIDATE_WEATHER:-internal/sample/testdata/weather.json}" --revision=candidate --log-level=debug --log-json=DEFAULT
proxy after=forecasts,server ready=http+unix:dist/sockets/health.sock:/readyz=204 timeout=90s: spectre proxy --server-url=http://spectre-server --server-socket="$(pwd)/dist/sockets/server.sock" --service=sample --environment=integration --revision=integration --listen="unix:$(pwd)/dist/sockets/ingress.sock" --reference-url="h2c+unix:$(pwd)/dist/sockets/reference.sock" --candidate-url="h2c+unix:$(pwd)/dist/sockets/candidate.sock" --reference-egress-listen="unix:$(pwd)/dist/sockets/egress-reference.sock" --candidate-egress-listen="unix:$(pwd)/dist/sockets/egress-candidate.sock" --egress-health-listen="unix:$(pwd)/dist/sockets/egress-health.sock" --health-listen="unix:$(pwd)/dist/sockets/health.sock" --destination="forecasts.example=http+unix:$(pwd)/dist/sockets/forecasts.sock" --scripts-dir=internal/sample/scripts --schema-dir=internal/sample/schema --descriptors-dir=dist/descriptors --match-window=1s --log-level=debug --log-json=DEFAULT
