# syntax=docker/dockerfile:1

# The {{ .service_name }} SPECTRE mirror image. One container runs the spectre
# supervisor with the reference and the candidate. See spectre/README.md.

# The SPECTRE commit or tag to build, matching the spectre init that wrote this file.
ARG SPECTRE_VERSION={{ .SpectreRef }}

FROM golang:1.27.1-alpine3.24 AS spectre
ARG SPECTRE_VERSION
RUN apk add --no-cache git
RUN git clone https://github.com/block/spectre.git /src \
    && git -C /src checkout --detach "${SPECTRE_VERSION}"
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w -buildid= -X github.com/block/spectre/internal.Version=${SPECTRE_VERSION}" \
      -o /out/ ./cmd/spectre

# Replace with a runtime base that can run both the reference and the candidate,
# then install them.
FROM alpine:3.24.2

COPY --from=spectre /out/spectre /usr/local/bin/
COPY spectre/scripts     /etc/spectre/scripts
COPY spectre/schema      /etc/spectre/schema
COPY spectre/descriptors /etc/spectre/descriptors
COPY spectre/bin         /etc/spectre/bin
COPY spectre/state.toml  /etc/spectre/state.toml

EXPOSE 50050
ENTRYPOINT ["/etc/spectre/bin/entrypoint"]
