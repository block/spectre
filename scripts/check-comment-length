#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
  set -- $(git ls-files '*.go')
fi

status=0

for file do
  [ -f "$file" ] || continue

  awk '
    function reject(start) {
      printf "%s:%d: comment exceeds two lines\n", FILENAME, start > "/dev/stderr"
      rejected = 1
    }

    function has_block_text(text) {
      sub(/\*\/.*$/, "", text)
      sub(/^[[:space:]]*\* ?/, "", text)
      return text ~ /[^[:space:]]/
    }

    {
      if (in_block) {
        if (has_block_text($0)) {
          block_lines++
          if (block_lines == 3) {
            reject(block_start)
          }
        }
        if ($0 ~ /\*\//) {
          in_block = 0
        }
        next
      }

      if ($0 ~ /^[[:space:]]*\/\//) {
        # Match Go doc directives without treating spaced prose as a directive.
        if ($0 ~ /^[[:space:]]*\/\/[[:space:]]*$/ ||
            $0 ~ /^[[:space:]]*\/\/(line |extern |export |[a-z0-9]+:[a-z0-9])/) {
          next
        }
        if (line_lines == 0) {
          line_start = FNR
        }
        line_lines++
        if (line_lines == 3) {
          reject(line_start)
        }
        next
      }

      line_lines = 0

      if ($0 ~ /\/\*/) {
        block_start = FNR
        remainder = $0
        sub(/^.*\/\*/, "", remainder)
        block_lines = has_block_text(remainder) ? 1 : 0
        if (remainder !~ /\*\//) {
          in_block = 1
        }
      }
    }

    END {
      exit rejected ? 1 : 0
    }
  ' "$file" || status=1
done

exit "$status"
