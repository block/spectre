#!/bin/bash

# Keeps the dependencies that each nested Go module compiles at the root
# module's versions. Any difference gives the shared packages different build
# cache keys, so every build compiles them once per module. The root module is
# the source of truth because it already selects at least the nested versions.
# With --check, reports differences instead of fixing them.

set -euo pipefail

usage='usage: go-module-sync [--check] MODULE_DIR...'
check=false
if [[ "${1:-}" == --check ]]; then
  check=true
  shift
fi
(($# > 0)) || {
  echo "$usage" >&2
  exit 2
}

cd "$(dirname "$0")/.."
export LC_ALL=C

# The caller's || disables set -e in these functions, and join ignores how its
# process substitutions exit, so every step checks its own status.

root_versions() {
  local versions
  versions=$(go list -m -f '{{if not .Main}}{{.Path}} {{.Version}}{{end}}' all) || return
  awk 'NF' <<<"$versions" | sort -u
}

# Tidy requires exactly the modules that provide packages on some platform, so
# other modules in the build list are never compiled and cannot be kept in step.
required_versions() {
  local paths versions
  paths=$(cd "$1" && go mod edit -json | jq -r '.Require[]?.Path') || return
  # shellcheck disable=SC2086 # One argument per required module.
  versions=$(cd "$1" && go list -m -f '{{.Path}} {{.Version}}' $paths) || return
  sort -u <<<"$versions"
}

# Prints "path root-version module-version" for each module that differs.
differences() {
  local root required
  root=$(root_versions) || return
  required=$(required_versions "$1") || return
  join <(echo "$root") <(echo "$required") | awk '$2 != $3'
}

sync_module() {
  local dir=$1 diffs
  # A new version can require further modules, so repeat until nothing moves.
  for _ in 1 2 3; do
    diffs=$(differences "$dir") || {
      echo "$dir: could not compare dependency versions with the root module" >&2
      return 1
    }
    [[ -z "$diffs" ]] && return 0
    if [[ $check == true ]]; then
      echo "$dir uses dependency versions that differ from the root module; run \"bit sync-go-modules\":" >&2
      awk '{print "  " $1 ": " $3 ", root module " $2}' <<<"$diffs" >&2
      return 1
    fi
    awk '{print $1 "@" $2}' <<<"$diffs" | (cd "$dir" && xargs go get) || return
    (cd "$dir" && go mod tidy) || return
  done
  echo "$dir still uses dependency versions that differ from the root module after syncing" >&2
  return 1
}

status=0
for dir in "$@"; do
  sync_module "$dir" || status=1
done
exit "$status"
