#!/bin/bash
set -euo pipefail

root="$(dirname "$(readlink -f "$0")")/.."
name="$(basename "$0")"
# Each binary's BUILD.bit target is its name without the spectre- prefix, plus -bin.
# The launcher also runs from shells where Hermit is inactive, so call its stub.
"${root}/bin/bit" -q "${name#spectre-}-bin"
exec "${root}/dist/${name}" "$@"
