# Build file for github.com/alecthomas/bit

# The TypeScript shim is a separate module, so Go tools skip it from the root.
let go-module = [".", "internal/typescript"]

sample-proto = exec {
  command = "mkdir -p internal/sample/pb dist/descriptors && buf generate && buf build --as-file-descriptor-set -o dist/descriptors/sample.pb"
  inputs = ["buf.yaml", "buf.gen.yaml", "internal/sample/proto/*.proto", "bin/.buf-1.73.0.pkg", "bin/.protoc-gen-go-1.36.12.pkg", "bin/.protoc-gen-connect-go-1.21.0.pkg"]
  output = ["internal/sample/pb/users.pb.go", "internal/sample/pb/service.pb.go", "internal/sample/pb/samplepbconnect/service.connect.go", "dist/descriptors/sample.pb"]
}

# Concurrent cold builds each compile the TypeScript compiler, so warm the cache once first.
typescript-compiler = go.build { package = "./internal/schema" }

# Analyzers report a compile error once per dependent package, so compile first.
build-go[go-module] = go.build {
  package = "./..."
  dir = go-module
  depends_on = [sample-proto, typescript-compiler]
}

# Keep protobuf declarations checked in, like the generated Go bindings.
sample-schema = exec {
  command = "spectre-gen proto --descriptors-dir=dist/descriptors --output=internal/sample/schema"
  inputs = ["internal/descriptors/*.go", "internal/schema/*.go", "internal/typescript/**/*.go", "internal/typescript/go.mod", "cmd/spectre-gen/*.go", "go.mod", "go.sum", "scripts/spectre-gen", "scripts/spectre-ingress"]
  output = ["internal/sample/schema/users.d.ts", "internal/sample/schema/service.d.ts"]
  depends_on = [sample-proto, typescript-compiler]
}

test-go[go-module](package = "./...", run = ".") = go.test {
  package = package
  dir = go-module
  flags = ["-timeout=30s", "-run=#{run}"]
  depends_on = [sample-schema, typescript-compiler]
}
test-comment-length = exec.test {
  command = "sh scripts/check-comment-length.test.sh"
  inputs = ["scripts/check-comment-length", "scripts/check-comment-length.test.sh"]
}
test-launcher = exec.test {
  command = "scripts/spectre-ingress.test.sh"
  inputs = ["scripts/spectre-ingress", "scripts/spectre-ingress.test.sh"]
}
test-response-comparison-integration = exec.test {
  command = "response-comparison.integration.test.sh"
  inputs = ["Procfile.integration", "scripts/response-comparison.integration.test.sh", "scripts/spectre-ingress", "scripts/spectre-egress", "scripts/spectre-sample", "scripts/spectre-sample-forecasts", "internal/**/*.ts", "internal/sample/testdata/*.json"]
  depends_on = [ingress-bin, egress-bin, sample-bin, sample-forecasts-bin, sample-schema]
}
test-release-version = exec.test {
  command = "scripts/release-version.test.sh"
  inputs = [".gitsv/config.yml", "scripts/release-version.test.sh", "bin/.git-sv-3.0.2.pkg"]
}
test-container-publisher = exec.test {
  command = "sh scripts/publish-container-images.test.sh"
  inputs = ["scripts/publish-container-images", "scripts/publish-container-images.test.sh"]
}
explicit test-container(version = "dev") = exec.test {
  command = "container.test.sh #{local-image(version = version).ref} #{version}"
  inputs = ["scripts/container.test.sh"]
}
fmt-go[go-module] = go.fmt { dir = go-module }
fmt-check-go[go-module] = go.fmt-l { dir = go-module }
fmt-action-pins = exec {
  command = "ratchet pin .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/.ratchet-0.12.0.pkg"]
}
lint-go[go-module] = go.lint {
  concurrency = 1 # golangci-lint refuses to run while another instance holds its lock.
  dir = go-module
  depends_on = [sample-proto]
}
lint-proto = exec.test {
  command = "buf lint"
  inputs = ["buf.yaml", "internal/sample/proto/*.proto", "bin/.buf-1.73.0.pkg"]
}
lint-actions = exec {
  command = "actionlint"
  inputs = [".github/workflows/*.yml", "bin/.actionlint-1.7.12.pkg"]
}
lint-action-pins = exec {
  command = "ratchet lint .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/.ratchet-0.12.0.pkg"]
}
lint-dockerfile = exec.test {
  command = "hadolint Dockerfile"
  inputs = ["Dockerfile", "bin/.hadolint-2.15.1.pkg"]
}
lint-release = exec.test {
  command = "goreleaser check"
  inputs = [".goreleaser.yaml", "bin/.goreleaser-2.18.2.pkg"]
}
lint-scripts = exec {
  command = "shellcheck scripts/*"
  inputs = ["scripts/*", "bin/.shellcheck-0.11.0.pkg"]
}
lint-tsk[go-module] = exec.test {
  command = "tsk"
  dir = go-module
  inputs = ["#{go-module}/**/*.go", "#{go-module}/go.mod", "#{go-module}/go.sum", ".tsk.toml", "bin/.tsktsk-0.2.0.pkg"]
  depends_on = [build-go]
}

explicit sample-bin = go.exe {
  package = "./cmd/spectre-sample"
  output = "dist/spectre-sample"
  depends_on = [sample-proto]
}
explicit sample-forecasts-bin = go.exe {
  package = "./cmd/spectre-sample-forecasts"
  output = "dist/spectre-sample-forecasts"
  depends_on = [sample-proto]
}
explicit ingress-bin = go.exe {
  package = "./cmd/spectre-ingress"
  output = "dist/spectre-ingress"
  depends_on = [typescript-compiler]
}
explicit egress-bin = go.exe {
  package = "./cmd/spectre-egress"
  output = "dist/spectre-egress"
  depends_on = [typescript-compiler]
}
explicit local-image(version = "dev") = docker.image {
  tag = "spectre:#{version}"
  build_args = { VERSION = version }
}
explicit publish-release-image(registry : string, image-tag : string, version : string) = docker.image {
  tag = "#{registry}/spectre:#{image-tag}"
  build_args = { VERSION = version }
  platform = ["linux/amd64", "linux/arm64"]
}

# Generate the sample descriptors and build its servers.
target sample = [sample-bin, sample-forecasts-bin]

# Build the ingress and egress container image.
target container = [local-image]

# Publish the ingress and egress container image.
target publish-container(registry : string, image-tag : string, version : string) = [publish-release-image(registry = registry, image-tag = image-tag, version = version)]

# Run all tests
target test = [test-go, test-comment-length, test-launcher, test-response-comparison-integration, test-release-version, test-container-publisher]

# Lint everything
target lint = [lint-go, lint-tsk, lint-proto, lint-actions, lint-action-pins, lint-dockerfile, lint-release, lint-scripts, fmt-check-go]

# Format everything
target fmt = [fmt-go, fmt-action-pins]
