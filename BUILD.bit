# Build file for github.com/alecthomas/bit

# The TypeScript shim is a separate module, so Go tools skip it from the root.
let go-module = [".", "internal/typescript"]

# Files within a Go module that its checks depend on.
let go-inputs = ["**/*.go", "go.mod", "go.sum"]

let tsk-inputs = [".tsk/config.toml", ".tsk/lock.toml", ".tsk/**/*.ts", "bin/tsk"]

sample-proto = buf.generate { input = "internal/sample/proto" }

sample-descriptors = exec {
  command = "mkdir -p dist/descriptors && buf build internal/sample/proto --as-file-descriptor-set -o dist/descriptors/sample.pb"
  inputs = ["buf.yaml", "internal/sample/proto/*.proto", "bin/buf"]
  outputs = ["dist/descriptors/sample.pb"]
}

coordinator-proto = buf.generate {
  dir = "internal/coordinator"
  input = "proto"
}

# Concurrent cold builds each compile the TypeScript compiler, so warm the cache once first.
typescript-compiler = go.build { package = "./internal/schema" }

# Analyzers report a compile error once per dependent package, so compile first.
build-go[go-module] = go.build {
  package = "./..."
  dir = go-module
  depends_on = [sample-proto, coordinator-proto, typescript-compiler]
}

# Keep protobuf declarations checked in, like the generated Go bindings.
sample-schema = exec {
  command = "spectre gen proto --descriptors-dir=dist/descriptors --output=internal/sample/schema"
  inputs = ["internal/descriptors/*.go", "internal/schema/*.go", "internal/typescript/**/*.go", "internal/typescript/go.mod", "*.go", "cmd/spectre/*.go", "go.mod", "go.sum", "scripts/spectre"]
  outputs = ["internal/sample/schema/users.d.ts", "internal/sample/schema/service.d.ts"]
  depends_on = [sample-descriptors, typescript-compiler]
}

test-go[go-module](package = "./...", run = ".") = go.test {
  package = package
  dir = go-module
  flags = ["-timeout=30s", "-run=#{run}"]
  depends_on = [sample-schema, typescript-compiler]
}
test-launcher = exec.test {
  command = "spectre.test.sh"
  inputs = ["scripts/spectre", "scripts/spectre.test.sh"]
}
test-response-comparison-integration = exec.test {
  command = "response-comparison.integration.test.sh"
  inputs = ["Procfile.integration", "scripts/response-comparison.integration.test.sh", "scripts/spectre", "scripts/spectre-sample", "scripts/spectre-sample-forecasts", "internal/**/*.ts", "internal/sample/testdata/*.json", "bin/jq"]
  depends_on = [spectre-bin, sample-bin, sample-forecasts-bin, sample-schema]
}
test-release-version = exec.test {
  command = "scripts/release-version.test.sh"
  inputs = [".gitsv/config.yml", "scripts/release-version.test.sh", "bin/git-sv"]
}
# tsk test fails when no linter has test data.
test-tsk = exec.test {
  command = "test ! -d .tsk/testdata || tsk test"
  inputs = tsk-inputs + [".tsk/testdata/**/*"]
}
test-container-publisher = exec.test {
  command = "sh scripts/publish-container-images.test.sh"
  inputs = ["scripts/publish-container-images", "scripts/publish-container-images.test.sh"]
}
explicit test-container(version = "dev") = exec.test {
  command = "container.test.sh #{local-image(version = version).ref} #{version}"
  inputs = ["scripts/container.test.sh"]
}
fmt-go[go-module] = go.fmt { dir = go-module }
fmt-check-go[go-module] = go.fmt-l { dir = go-module }
fmt-action-pins = exec {
  command = "ratchet pin .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/ratchet"]
}
fmt-toml = exec {
  command = "taplo format"
  inputs = ["**/*.toml"]
}
# tsk init rewrites only its own section of AGENTS.md. Its outputs are agent
# instructions, not build artefacts, so cleaning must not delete them.
protected fmt-tsk = exec {
  command = "tsk init"
  inputs = tsk-inputs + ["AGENTS.md"]
  outputs = ["AGENTS.md", ".tsk/.gitignore", ".agents/skills/tsk/SKILL.md", ".claude/skills/tsk/SKILL.md"]
}
lint-proto = exec.test {
  command = "buf lint"
  inputs = ["buf.yaml", "internal/sample/proto/*.proto", "internal/coordinator/proto/*.proto", "bin/buf"]
}
lint-actions = exec {
  command = "actionlint"
  inputs = [".github/workflows/*.yml", "bin/actionlint"]
}
lint-action-pins = exec {
  command = "ratchet lint .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/ratchet"]
}
lint-dockerfile = exec.test {
  command = "hadolint Dockerfile"
  inputs = ["Dockerfile", "bin/hadolint"]
}
lint-release = exec.test {
  command = "goreleaser check"
  inputs = [".goreleaser.yaml", "bin/goreleaser"]
}
lint-scripts = exec {
  command = "shellcheck scripts/*"
  inputs = ["scripts/*", "bin/shellcheck"]
}
lint-tsk[go-module] = exec.test {
  command = "tsk lint ./..."
  dir = go-module
  inputs = tsk-inputs + prefix(go-inputs, "#{go-module}/")
  depends_on = [build-go]
}

explicit sample-bin = go.exe {
  package = "./cmd/spectre-sample"
  output = "dist/spectre-sample"
  depends_on = [sample-proto]
}
explicit sample-forecasts-bin = go.exe {
  package = "./cmd/spectre-sample-forecasts"
  output = "dist/spectre-sample-forecasts"
  depends_on = [sample-proto]
}
explicit spectre-bin = go.exe {
  package = "./cmd/spectre"
  output = "dist/spectre"
  depends_on = [coordinator-proto, typescript-compiler]
}
explicit local-image(version = "dev") = docker.image {
  tag = "spectre:#{version}"
  build_args = { VERSION = version }
}
explicit publish-release-image(registry : string, image-tag : string, version : string) = docker.image {
  tag = "#{registry}/spectre:#{image-tag}"
  build_args = { VERSION = version }
  platform = ["linux/amd64", "linux/arm64"]
}

# Generate the sample descriptors and build its servers.
target sample = [sample-bin, sample-forecasts-bin]

# Build the spectre container image.
target container = [local-image]

# Publish the spectre container image.
target publish-container(registry : string, image-tag : string, version : string) = [publish-release-image(registry = registry, image-tag = image-tag, version = version)]

# Run all tests
target test = [test-go, test-launcher, test-response-comparison-integration, test-release-version, test-container-publisher, test-tsk]

# Lint everything
target lint = [lint-tsk, lint-proto, lint-actions, lint-action-pins, lint-dockerfile, lint-release, lint-scripts, fmt-check-go]

# Format everything
target fmt = [fmt-go, fmt-action-pins, fmt-toml, fmt-tsk]
