# Build file for github.com/alecthomas/bit

# The TypeScript shim is a separate module, so Go tools skip it from the root.
let go-module = go.modules()

# Files within a Go module that its checks depend on.
let go-inputs = ["**/*.go", "go.mod", "go.sum"]

# The images copy in Linux binaries built here rather than compiling inside
# Docker, so they reuse the host's Go build cache. Each image's build context
# holds one directory per platform, named like Docker's TARGETOS-TARGETARCH.
let image-goarch = ["amd64", "arm64"]
let image-command = ["spectre", "spectre-sample", "spectre-sample-forecasts"]
# Local images build only for the host's architecture, Docker's default.
let host-goarch = exec("go env GOARCH") | trim

let tsk-inputs = [".tsk/config.toml", ".tsk/lock.toml", ".tsk/**/*.ts", "bin/tsk"]

sample-proto = buf.generate { input = "internal/sample/proto" }

sample-descriptors = exec {
  command = "mkdir -p dist/descriptors && buf build internal/sample/proto --as-file-descriptor-set -o dist/descriptors/sample.pb"
  inputs = ["buf.yaml", "internal/sample/proto/*.proto", "bin/buf"]
  outputs = ["dist/descriptors/sample.pb"]
}

spectre-proto = buf.generate {
  input = "proto"
  template = "proto/buf.gen.yaml"
}

# Concurrent cold builds each compile the TypeScript compiler, so warm the cache once first.
typescript-compiler = go.build { package = "./internal/schema" }

# Analyzers report a compile error once per dependent package, so compile first.
build-go[go-module] = go.build {
  package = "./..."
  dir = go-module
  depends_on = [sample-proto, spectre-proto, typescript-compiler]
}

# Keep protobuf declarations checked in, like the generated Go bindings.
sample-schema = exec {
  command = "spectre gen proto --descriptors-dir=dist/descriptors --output=internal/sample/schema"
  inputs = ["internal/descriptors/*.go", "internal/schema/*.go", "internal/typescript/**/*.go", "internal/typescript/go.mod", "*.go", "cmd/spectre/*.go", "go.mod", "go.sum", "scripts/spectre"]
  outputs = ["internal/sample/schema/users.d.ts", "internal/sample/schema/service.d.ts"]
  depends_on = [sample-descriptors, typescript-compiler]
}

test-go[go-module](package = "./...", run = ".") = go.test {
  package = package
  dir = go-module
  flags = ["-timeout=30s", "-run=#{run}"]
  depends_on = [sample-schema, typescript-compiler]
}
test-launcher = exec.test {
  command = "spectre.test.sh"
  inputs = ["scripts/spectre", "scripts/spectre.test.sh"]
}
# Only the integration build tag includes these tests, and CI runs them in their own
# job. They read the sample's scripts, schema and descriptors, which go cannot see, so
# -count=1 stops it caching the result.
test-integration(run = ".") = go.test {
  package = "./internal/integration"
  flags = ["-tags=integration", "-count=1", "-timeout=5m", "-run=#{run}"]
  inputs = go-inputs + ["internal/**/*.ts", "internal/sample/testdata/*.json"]
  depends_on = [sample-descriptors, sample-schema, typescript-compiler]
}
test-release-version = exec.test {
  command = "release-version.test.sh"
  inputs = [".svu.yml", "scripts/release-version.test.sh", "bin/svu"]
}
# tsk test fails when no linter has test data.
test-tsk = exec.test {
  command = "test ! -d .tsk/testdata || tsk test"
  inputs = tsk-inputs + [".tsk/testdata/**/*"]
}
test-container-images = exec.test {
  command = "container-images.test.sh"
  inputs = ["scripts/container-images", "scripts/container-images.test.sh"]
}
explicit test-container(version = "dev") = exec.test {
  command = "container.test.sh #{local-image(version = version).ref} #{version}"
  inputs = ["scripts/container.test.sh"]
}
# Runs the demo image as a multi-container mirror pod in a local kind cluster.
explicit test-mirror-pod = exec.test {
  command = "mirror-pod.test.sh #{demo-image.ref}"
  inputs = ["scripts/mirror-pod.test.sh", "demo/mirror-pod.yaml", "bin/kind", "bin/kubectl"]
}
fmt-go[go-module] = go.fmt { dir = go-module }
fmt-check-go[go-module] = go.fmt-l { dir = go-module }
fmt-action-pins = exec {
  command = "ratchet pin .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/ratchet"]
}
# Files that decide which dependency versions the TypeScript shim module compiles.
let go-module-sync-inputs = ["go.mod", "go.sum", "internal/typescript/go.mod", "internal/typescript/go.sum", "scripts/go-module-sync", "bin/go", "bin/jq"]
# The pre-commit hook runs this, so it stays out of fmt.
sync-go-modules = exec {
  command = "go-module-sync internal/typescript"
  inputs = go-module-sync-inputs
}
fmt-toml = exec {
  command = "taplo format"
  inputs = ["**/*.toml"]
}
# tsk init rewrites only its own section of AGENTS.md. Its outputs are agent
# instructions, not build artefacts, so cleaning must not delete them.
protected fmt-tsk = exec {
  command = "tsk init"
  inputs = tsk-inputs + ["AGENTS.md"]
  outputs = ["AGENTS.md", ".tsk/.gitignore", ".agents/skills/tsk/SKILL.md", ".claude/skills/tsk/SKILL.md"]
}
lint-proto = buf.lint {}
lint-actions = exec {
  command = "actionlint"
  inputs = [".github/workflows/*.yml", "bin/actionlint"]
}
lint-action-pins = exec {
  command = "ratchet lint .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/ratchet"]
}
lint-dockerfile = exec.test {
  command = "hadolint Dockerfile"
  inputs = ["Dockerfile", "bin/hadolint"]
}
lint-release = exec.test {
  command = "goreleaser check"
  inputs = [".goreleaser.yaml", "bin/goreleaser"]
}
lint-scripts = exec {
  command = "shellcheck scripts/*"
  inputs = ["scripts/*", "bin/shellcheck"]
}
lint-go-modules = exec.test {
  command = "go-module-sync --check internal/typescript"
  inputs = go-module-sync-inputs
}
# The tag lints the integration tests too, which only it includes.
lint-tsk[go-module] = exec.test {
  command = "GOFLAGS=\"$GOFLAGS -tags=integration\" tsk lint ./..."
  dir = go-module
  inputs = tsk-inputs + prefix(go-inputs, "#{go-module}/")
  depends_on = [build-go]
}

explicit sample-bin = go.exe {
  package = "./cmd/spectre-sample"
  output = "dist/spectre-sample"
  depends_on = [sample-proto]
}
explicit sample-forecasts-bin = go.exe {
  package = "./cmd/spectre-sample-forecasts"
  output = "dist/spectre-sample-forecasts"
  depends_on = [sample-proto]
}
explicit spectre-bin = go.exe {
  package = "./cmd/spectre"
  output = "dist/spectre"
  depends_on = [spectre-proto, typescript-compiler]
}
# Matches the release binaries' flags in .goreleaser.yaml.
explicit image-bin[image-goarch, image-command](version : string) = go.exe {
  package = "./cmd/#{image-command}"
  output = "dist/image/#{version}/linux-#{image-goarch}/#{image-command}"
  goos = "linux"
  goarch = image-goarch
  flags = ["-ldflags=-s -w -buildid= -X github.com/block/spectre/internal.Version=#{version}"]
  depends_on = [spectre-proto, sample-proto, typescript-compiler]
}
explicit local-image(version = "dev") = docker.image {
  tag = "spectre:#{version}"
  build_contexts = { binaries = "dist/image/#{version}" }
  depends_on = [image-bin[host-goarch, "spectre"](version = version)]
}
# The demo image carries the sample descriptors, so generate them first.
explicit demo-image = docker.image {
  tag = "spectre-demo"
  dockerfile = "demo/Dockerfile"
  build_contexts = { binaries = "dist/image/demo" }
  depends_on = [
    sample-descriptors,
    image-bin[host-goarch, "spectre"](version = "demo"),
    image-bin[host-goarch, "spectre-sample"](version = "demo"),
    image-bin[host-goarch, "spectre-sample-forecasts"](version = "demo"),
  ]
}
explicit publish-release-image(registry : string, image-tag : string, version : string) = docker.image {
  tag = "#{registry}/spectre:#{image-tag}"
  platform = ["linux/amd64", "linux/arm64"]
  build_contexts = { binaries = "dist/image/#{version}" }
  depends_on = [
    image-bin["amd64", "spectre"](version = version),
    image-bin["arm64", "spectre"](version = version),
  ]
}

# Generate the sample descriptors and build its servers.
group sample = [sample-bin, sample-forecasts-bin]

# Build the spectre container image.
group container = [local-image]

# Build the demo container image.
group demo = [demo-image]

# Publish the spectre container image.
group publish-container(registry : string, image-tag : string, version : string) = [publish-release-image(registry = registry, image-tag = image-tag, version = version)]

# Run all tests
group test = [test-go, test-launcher, test-release-version, test-container-images, test-tsk]

# Lint everything
group lint = [lint-go-modules, lint-tsk, lint-proto, lint-actions, lint-action-pins, lint-dockerfile, lint-release, lint-scripts, fmt-check-go]

# Format everything
group fmt = [fmt-go, fmt-action-pins, fmt-toml, fmt-tsk]
